#!/usr/bin/env python3
"""Fire CT the instant the UPS USB re-appears after a link loss.

The deep self-test (TL) keeps discharging even when the USB bridge drops, so a
lost link during a test is not a stopped test.  This helper only waits for the
device node, then runs the normal cancel sequence
(stop ups-poller -> ups-selftest cancel -> start ups-poller) once, and exits.
"""
import subprocess
import sys
import time

VENDOR = '0925'
PRODUCT = '1234'
MAX_WAIT = int(sys.argv[1]) if len(sys.argv) > 1 else 1800
GRACE = 4.0


def present():
    try:
        out = subprocess.run(['lsusb'], capture_output=True, text=True,
                             timeout=10).stdout
    except Exception:
        return False
    return ('%s:%s' % (VENDOR, PRODUCT)) in out


def main():
    deadline = time.time() + MAX_WAIT
    print('waiting for %s:%s (max %d s)' % (VENDOR, PRODUCT, MAX_WAIT), flush=True)
    if present():
        print('device already present, cancelling now', flush=True)
    else:
        while time.time() < deadline:
            if present():
                break
            time.sleep(1.0)
        else:
            print('device never came back, giving up', flush=True)
            return 1
        print('device visible again, waiting %.0f s to settle' % GRACE, flush=True)
        time.sleep(GRACE)
    for cmd in (
        ['systemctl', 'stop', 'ups-poller'],
        ['/usr/local/sbin/ups-selftest', 'cancel'],
        ['systemctl', 'start', 'ups-poller'],
    ):
        try:
            p = subprocess.run(cmd, capture_output=True, text=True, timeout=90)
            print('%s -> %d %s' % (' '.join(cmd), p.returncode,
                                   (p.stderr or p.stdout).strip()[:200]), flush=True)
        except Exception as exc:
            print('%s failed: %s' % (' '.join(cmd), exc), flush=True)
    return 0


sys.exit(main())
