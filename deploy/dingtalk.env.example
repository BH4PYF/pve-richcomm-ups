# Copy to /etc/ups-dingtalk/dingtalk.env, chmod 600, chown root:root.
# Fill in your own DingTalk custom-robot credentials.  Never commit this file.
#
# DINGTALK_WEBHOOK_URL must be the full HTTPS URL, including access_token.
DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=REPLACE_ME
# Optional: the "加签" secret (SEC...).  Leave empty if the robot uses
# keyword-only security.
DINGTALK_SECRET=
